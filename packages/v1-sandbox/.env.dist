# Copy this file to .env for local v1-sandbox e2e runs.
#
# Empty SANDBOX_BASE_URL means Playwright starts the local sandbox dev server
# from this workspace and uses http://127.0.0.1:4173.
#
# If sandbox is already running externally, set the full sandbox shell URL:
#   OrbStack/macOS: http://v1.embed-ui-sandbox.local
#   Linux/Traefik: http://v1.embed-ui-sandbox.test
SANDBOX_BASE_URL=

# Common extension URL used by page e2e tests.
# Expected shape: %extension-url%/extension/%extension-id% http://web-extensions-server.simla.local/extension/<uid>
SANDBOX_EXTENSION_URL=

# Page runner settings.
SANDBOX_EXTENSION_PAGE_CODE=returns

# Widget runner settings.
SANDBOX_EXTENSION_TARGET=order/card:common.after

# Fixture used by external extension e2e tests.
SANDBOX_EXTENSION_FIXTURE=order-basic

# Optional split settings when page and widget extensions are different.
SANDBOX_PAGE_EXTENSION_URL=
SANDBOX_PAGE_EXTENSION_CODE=
SANDBOX_WIDGET_EXTENSION_URL=
SANDBOX_WIDGET_EXTENSION_TARGET=
