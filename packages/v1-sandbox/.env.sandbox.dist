# Copy this file to .env.sandbox for local v1-sandbox e2e runs.
#
# Empty SANDBOX_BASE_URL means Playwright starts the local sandbox dev server
# from this workspace and uses http://127.0.0.1:4173.
#
# If sandbox is already running externally, set the full sandbox shell URL:
#   OrbStack/macOS: http://v1.embed-ui-sandbox.local
#   Linux/Traefik: http://v1.embed-ui-sandbox.test
SANDBOX_BASE_URL=

# Empty SANDBOX_EXTENSION_URL means Playwright builds and starts the repository
# fixture extension server at http://127.0.0.1:4175/extension/.
# Set it to override the fixture server with an external extension server.
# Expected shape: %extension-url%/extension/
# Test helpers append extension UUIDs from fixture descriptors.
SANDBOX_EXTENSION_URL=
