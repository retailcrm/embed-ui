# Copy this file to .env.sandbox for local v1-sandbox e2e runs.
#
# Empty SANDBOX_BASE_URL means Playwright starts the local sandbox dev server
# from this workspace and uses http://127.0.0.1:4173.
#
# If sandbox is already running externally, set the full sandbox shell URL:
#   OrbStack/macOS: http://v1.embed-ui-sandbox.local
#   Linux/Traefik: http://v1.embed-ui-sandbox.test
SANDBOX_BASE_URL=

# Empty SANDBOX_EXTENSION_DESCRIPTOR means Playwright uses extensions from the
# repository fixture server. Set a one-line runtime descriptor to replace the
# fixture with the same code by an extension running on an external server.
SANDBOX_EXTENSION_DESCRIPTOR={"code":"promoModule","baseUrl":"http://web-extensions-server.simla.local","entrypoint":"/extension/8ebe1617-d609-43e4-b35a-fbfae011eee3/script","stylesheet":"/extension/8ebe1617-d609-43e4-b35a-fbfae011eee3/stylesheet","targets":[],"pages":["settings"]}
