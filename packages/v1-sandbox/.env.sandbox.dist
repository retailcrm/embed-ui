# Copy this file to .env.sandbox for local v1-sandbox e2e runs.
#
# Empty SANDBOX_BASE_URL means Playwright starts one server for the sandbox and test extensions
# from this workspace and uses http://127.0.0.1:4173.
#
# If the E2E server is already running via dev:e2e, set its full sandbox shell URL:
#   OrbStack/macOS: http://v1.embed-ui-sandbox.local
#   Linux/Traefik: http://v1.embed-ui-sandbox.test
SANDBOX_BASE_URL=http://127.0.0.1:4173
